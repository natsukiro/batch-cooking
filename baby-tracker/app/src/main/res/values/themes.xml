<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PetitRythme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
    </style>

    <!-- Fenêtre transparente : la fiche de saisie apparaît par-dessus l'écran d'accueil. -->
    <style name="Theme.PetitRythme.Quick" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <style name="WidgetPreviewButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/widget_preview_btn</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#221A1D</item>
        <item name="android:textSize">12sp</item>
    </style>

    <color name="splash_bg">#FFF8F4</color>
    <color name="icon_bg">#FCE3EA</color>
</resources>
